# ==============================================================================
# SCIENTIFIC RESEARCH SKILLS — CẤU HÌNH API KEYS CỔNG HỌC THUẬT & DỊCH VỤ
# ==============================================================================
# Hướng dẫn:
# 1. Copy file này thành .env ở thư mục gốc của dự án nghiên cứu:
#    cp .agents/skills/research-hub/.env.template .env
# 2. Điền các thông tin / API key tương ứng của bạn.
# 3. File .env sẽ chứa thông tin bí mật, luôn giữ trong .gitignore và không commit lên git.

# 1. OpenReview (Khuyến nghị cho rs-paper-search khi tìm bài báo tại ICLR, NeurIPS, ICML)
OPENREVIEW_USER=your_openreview_email@example.com
OPENREVIEW_PASS=your_openreview_password

# 2. OpenAlex (Polite Pool: Giúp tăng tốc độ truy vấn từ 1 req/s lên 10 req/s miễn phí)
OPENALEX_MAILTO=your_email@example.com
OPENALEX_API_KEY=your_openalex_api_key_if_any

# 3. Semantic Scholar (Tránh bị giới hạn tần suất HTTP 429 khi tra cứu paper-lookup/rs-paper-search)
SEMANTICSCHOLAR_API_KEY=your_semanticscholar_key_if_any

# 4. Proxy Google Scholar & Exa Search (Tùy chọn)
SCRAPER_API_KEY=your_scraperapi_key_if_any
EXA_API_KEY=your_exa_key_if_any
